---
interface Props {
  /** Extra classes, typically a colour pair from DOMAIN_META / STATUS_META. */
  class?: string;
  mono?: boolean;
}

const { class: className = 'border-line text-muted', mono = true } = Astro.props;
---

<span
  class:list={[
    'inline-flex items-center gap-1.5 rounded-full border px-2.5 py-0.5 text-[0.6875rem] leading-5 whitespace-nowrap',
    mono && 'font-mono',
    className,
  ]}
>
  <slot />
</span>
