---
import { SITE, SOCIALS, NAV, RESUME } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="mt-24 border-t border-line bg-bg-sunk">
  <div class="mx-auto max-w-5xl px-5 py-12 sm:px-8">
    <div class="flex flex-col gap-8 sm:flex-row sm:justify-between">
      <div class="max-w-xs">
        <p class="font-mono text-sm font-medium text-ink">{SITE.name}</p>
        <p class="mt-2 text-sm leading-relaxed text-muted">{SITE.role}</p>
        <p class="mt-1 text-sm text-faint">{SITE.location}</p>
      </div>

      <div class="flex gap-12">
        <nav aria-label="Footer">
          <p class="eyebrow">Site</p>
          <ul class="mt-3 space-y-2">
            {
              NAV.map((item) => (
                <li>
                  <a class="text-sm text-muted transition-colors hover:text-ink" href={item.href}>
                    {item.label}
                  </a>
                </li>
              ))
            }
            {
              RESUME.href && (
                <li>
                  <a class="text-sm text-muted transition-colors hover:text-ink" href={RESUME.href}>
                    Resume
                  </a>
                </li>
              )
            }
          </ul>
        </nav>

        <div>
          <p class="eyebrow">Elsewhere</p>
          <ul class="mt-3 space-y-2">
            {
              SOCIALS.map((social) => (
                <li>
                  <a
                    class="text-sm text-muted transition-colors hover:text-ink"
                    href={social.href}
                    rel={social.href.startsWith('http') ? 'me noopener' : undefined}
                  >
                    {social.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>

    <p class="mt-10 border-t border-line pt-6 font-mono text-xs text-faint">
      &copy; {year} {SITE.name}. Built with Astro and Tailwind, hosted on Cloudflare Pages.
    </p>
  </div>
</footer>
