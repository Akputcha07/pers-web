---
import { SITE, NAV, RESUME } from '../data/site';
import ThemeToggle from './ThemeToggle.astro';

const path = Astro.url.pathname;
/** A nav item is active on its own page and on anything nested beneath it. */
const isActive = (href: string) => path === href || path.startsWith(href);
---

<header
  class="sticky top-0 z-50 border-b border-line bg-bg/85 backdrop-blur-md supports-[backdrop-filter]:bg-bg/70"
>
  <div class="mx-auto flex h-16 max-w-5xl items-center gap-4 px-5 sm:px-8">
    <a
      href="/"
      class="group flex items-center gap-2.5 font-mono text-sm font-medium tracking-tight text-ink"
    >
      <span
        class="grid size-7 shrink-0 place-items-center rounded border border-line-strong bg-surface text-[0.6875rem] font-semibold text-accent transition-colors group-hover:border-accent"
        aria-hidden="true"
      >
        {SITE.name.slice(0, 1)}
      </span>
      <span class="hidden sm:inline">{SITE.name}</span>
    </a>

    <nav class="ml-auto hidden items-center gap-1 sm:flex" aria-label="Main">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'rounded-md px-3 py-1.5 text-sm transition-colors',
              isActive(item.href)
                ? 'text-ink font-medium bg-bg-sunk'
                : 'text-muted hover:text-ink',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      {
        RESUME.href && (
          <a
            href={RESUME.href}
            class="ml-1 rounded-md border border-line px-3 py-1.5 text-sm text-muted transition-colors hover:border-accent hover:text-accent"
          >
            Resume
          </a>
        )
      }
    </nav>

    <div class="ml-auto flex items-center gap-2 sm:ml-2">
      <ThemeToggle />
      <button
        type="button"
        id="menu-toggle"
        class="grid size-9 place-items-center rounded-md border border-line text-muted transition-colors hover:text-ink sm:hidden"
        aria-label="Toggle navigation menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
      </button>
    </div>
  </div>

  <nav
    id="mobile-nav"
    class="border-t border-line bg-bg sm:hidden"
    aria-label="Main"
    hidden
  >
    <div class="mx-auto max-w-5xl px-5 py-2">
      {
        NAV.map((item) => (
          <a
            href={item.href}
            aria-current={isActive(item.href) ? 'page' : undefined}
            class:list={[
              'block rounded-md px-3 py-2.5 text-sm',
              isActive(item.href) ? 'text-ink font-medium bg-bg-sunk' : 'text-muted',
            ]}
          >
            {item.label}
          </a>
        ))
      }
      {
        RESUME.href && (
          <a href={RESUME.href} class="block rounded-md px-3 py-2.5 text-sm text-accent">
            Resume (PDF)
          </a>
        )
      }
    </div>
  </nav>
</header>

<script>
  function wireMenu() {
    const button = document.getElementById('menu-toggle');
    const panel = document.getElementById('mobile-nav');
    if (!button || !panel || button.dataset.wired === 'true') return;
    button.dataset.wired = 'true';

    button.addEventListener('click', () => {
      const open = panel.hidden;
      panel.hidden = !open;
      button.setAttribute('aria-expanded', String(open));
    });
  }

  wireMenu();
  document.addEventListener('astro:after-swap', wireMenu);
</script>
