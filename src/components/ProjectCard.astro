---
import Chip from './Chip.astro';
import { DOMAIN_META, STATUS_META, formatRange, type Project } from '../lib/projects';

interface Props {
  project: Project;
  /** Compact cards drop the cover image and tech chips (used on the homepage). */
  compact?: boolean;
}

const { project, compact = false } = Astro.props;
const { data } = project;

const domain = DOMAIN_META[data.domain];
const status = data.status ? STATUS_META[data.status] : undefined;
const href = `/projects/${project.id}/`;

// Keep cards visually even; the detail page lists the full stack.
const shownTech = data.tech.slice(0, 5);
const overflowTech = data.tech.length - shownTech.length;
---

<article
  class="group relative flex flex-col overflow-hidden rounded-lg border border-line bg-surface transition-all duration-200 hover:border-line-strong hover:shadow-[0_1px_3px_rgba(0,0,0,0.04),0_8px_24px_-12px_rgba(0,0,0,0.12)] focus-within:border-accent"
  data-project
  data-domain={data.domain}
  data-status={data.status}
  data-tech={data.tech.join('|').toLowerCase()}
  data-title={data.title.toLowerCase()}
  data-summary={data.summary.toLowerCase()}
>
  {
    !compact && data.cover && (
      <img
        src={data.cover}
        alt={data.coverAlt ?? ''}
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full border-b border-line object-cover"
      />
    )
  }

  <div class="flex flex-1 flex-col p-5">
    <div class="flex flex-wrap items-center gap-2">
      <Chip class={domain.chip}>
        <span class:list={['size-1.5 rounded-full', domain.dot]} aria-hidden="true"></span>
        {domain.label}
      </Chip>
      {status && <Chip class={status.chip}>{status.label}</Chip>}
    </div>

    <h3 class="mt-3 text-base font-semibold tracking-tight text-ink">
      <a href={href} class="after:absolute after:inset-0 after:content-['']">
        {data.title}
      </a>
    </h3>

    <p class="mt-2 text-sm leading-relaxed text-muted">{data.summary}</p>

    <div class="mt-auto pt-4">
      {
        !compact && shownTech.length > 0 && (
          <ul class="flex flex-wrap gap-1.5">
            {shownTech.map((item) => (
              <li class="rounded border border-line bg-bg-sunk px-1.5 py-0.5 font-mono text-[0.6875rem] text-faint">
                {item}
              </li>
            ))}
            {overflowTech > 0 && (
              <li class="px-1 py-0.5 font-mono text-[0.6875rem] text-faint">
                +{overflowTech}
              </li>
            )}
          </ul>
        )
      }
      {
        (data.started || data.org) && (
          <p class="mt-3 font-mono text-[0.6875rem] text-faint">
            {data.started && formatRange(data.started, data.ended)}
            {data.started && data.org && <span> &middot; </span>}
            {data.org && <span>{data.org}</span>}
          </p>
        )
      }
    </div>
  </div>
</article>
