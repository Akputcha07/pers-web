---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  /** Set to false on the homepage, which supplies its own full-bleed hero. */
  contained?: boolean;
}

const { title, description, image, type, contained = true } = Astro.props;
---

<!doctype html>
<html lang="en" class="h-full">
  <head>
    <BaseHead title={title} description={description} image={image} type={type} />
  </head>
  <body class="flex min-h-full flex-col">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-accent focus:px-4 focus:py-2 focus:text-sm focus:text-bg"
    >
      Skip to content
    </a>

    <Header />

    <main id="main" class="flex-1">
      {
        contained ? (
          <div class="mx-auto max-w-5xl px-5 py-14 sm:px-8 sm:py-20">
            <slot />
          </div>
        ) : (
          <slot />
        )
      }
    </main>

    <Footer />
  </body>
</html>
