---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="That page does not exist.">
  <div class="py-16 text-center sm:py-24">
    <p class="font-mono text-sm text-accent">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      Open circuit
    </h1>
    <p class="mx-auto mt-4 max-w-sm text-base leading-relaxed text-muted">
      There is nothing at this address. The link may be out of date, or the page
      may have moved.
    </p>

    <div class="mt-9 flex flex-wrap justify-center gap-3">
      <a
        href="/"
        class="rounded-md bg-accent px-4 py-2.5 text-sm font-medium text-bg transition-colors hover:bg-accent-hover"
      >
        Back home
      </a>
      <a
        href="/projects/"
        class="rounded-md border border-line-strong px-4 py-2.5 text-sm font-medium text-ink transition-colors hover:border-accent hover:text-accent"
      >
        Browse projects
      </a>
    </div>
  </div>
</BaseLayout>
