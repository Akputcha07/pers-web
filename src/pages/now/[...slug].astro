---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Chip from '../../components/Chip.astro';
import { getNowEntries, getProjects, formatDay } from '../../lib/projects';

export const getStaticPaths = (async () => {
  const entries = await getNowEntries();
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { Content } = await render(entry);

const projects = await getProjects();
const projectsById = new Map(projects.map((project) => [project.id, project]));
const linked = entry.data.projects
  .map((id) => projectsById.get(id))
  .filter((project) => project !== undefined);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} type="article">
  <a
    href="/now/"
    class="group inline-block font-mono text-xs text-muted transition-colors hover:text-accent"
  >
    <span class="inline-block transition-transform group-hover:-translate-x-0.5" aria-hidden="true">
      &larr;{' '}
    </span>
    Now
  </a>

  <article class="mt-6 max-w-2xl">
    <time datetime={entry.data.date.toISOString()} class="font-mono text-xs text-faint">
      {formatDay(entry.data.date)}
    </time>

    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">
      {entry.data.title}
    </h1>
    <p class="mt-4 text-lg leading-relaxed text-muted">{entry.data.summary}</p>

    {
      entry.data.focus.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2">
          {entry.data.focus.map((item) => (
            <li>
              <Chip class="border-line-strong bg-bg-sunk text-muted">{item}</Chip>
            </li>
          ))}
        </ul>
      )
    }

    <div class="prose prose-sm mt-10 max-w-none border-t border-line pt-10 sm:prose-base">
      <Content />
    </div>

    {
      linked.length > 0 && (
        <div class="mt-10 border-t border-line pt-6">
          <p class="eyebrow">Related projects</p>
          <ul class="mt-3 flex flex-wrap gap-2">
            {linked.map((project) => (
              <li>
                <a
                  href={`/projects/${project.id}/`}
                  class="inline-block rounded-md border border-line px-3 py-1.5 text-xs text-muted transition-colors hover:border-accent hover:text-accent"
                >
                  {project.data.title}
                </a>
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </article>
</BaseLayout>
