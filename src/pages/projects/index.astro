---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getProjects, DOMAIN_META, DOMAIN_ORDER } from '../../lib/projects';

const projects = await getProjects();

// Only offer a filter for domains that actually have projects behind them.
const counts = Object.fromEntries(
  DOMAIN_ORDER.map((domain) => [domain, projects.filter((p) => p.data.domain === domain).length]),
) as Record<(typeof DOMAIN_ORDER)[number], number>;

const filters = [
  { value: 'all', label: 'All', count: projects.length },
  ...DOMAIN_ORDER.filter((domain) => counts[domain] > 0).map((domain) => ({
    value: domain as string,
    label: DOMAIN_META[domain].label,
    count: counts[domain],
  })),
];
---

<BaseLayout
  title="Projects"
  description="Software and hardware projects, from an AI-powered desktop app to a C++ document search engine and Arduino firmware."
>
  <header class="max-w-2xl">
    <p class="eyebrow">Portfolio</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-ink sm:text-4xl">Projects</h1>
    <p class="mt-4 text-base leading-relaxed text-muted">
      Software and hardware projects, from an AI-powered desktop app to a C++
      document search engine and Arduino firmware.
    </p>
  </header>

  {/* ------------------------------------------------------------- Controls */}
  <div class="mt-10 flex flex-col gap-4 border-y border-line py-4 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-wrap gap-1.5" role="group" aria-label="Filter projects by domain">
      {
        filters.map((filter, index) => (
          <button
            type="button"
            data-filter={filter.value}
            aria-pressed={index === 0 ? 'true' : 'false'}
            class="rounded-md border border-line px-3 py-1.5 font-mono text-xs text-muted transition-colors hover:text-ink aria-pressed:border-accent aria-pressed:bg-accent-soft aria-pressed:text-accent"
          >
            {filter.label}
            <span class="ml-1.5 text-faint">{filter.count}</span>
          </button>
        ))
      }
    </div>

    <div class="relative sm:w-56">
      <label for="project-search" class="sr-only">Search projects</label>
      <input
        id="project-search"
        type="search"
        placeholder="Search by name or tech"
        autocomplete="off"
        class="w-full rounded-md border border-line bg-surface px-3 py-1.5 font-mono text-xs text-ink placeholder:text-faint focus:border-accent focus:outline-none"
      />
    </div>
  </div>

  {/* ----------------------------------------------------------------- Grid */}
  <div id="project-grid" class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {projects.map((project) => <ProjectCard project={project} />)}
  </div>

  <p id="empty-state" class="mt-12 text-center text-sm text-muted" hidden>
    No projects match that filter yet.
  </p>

  {
    projects.length === 0 && (
      <p class="mt-12 rounded-lg border border-dashed border-line-strong p-8 text-center text-sm text-muted">
        No projects published yet. Add a Markdown file to
        <code class="mx-1 font-mono text-xs text-ink">src/content/projects/</code>
        to get started.
      </p>
    )
  }
</BaseLayout>

<script>
  function wireProjectFilters() {
    const grid = document.getElementById('project-grid');
    if (!grid || grid.dataset.wired === 'true') return;
    grid.dataset.wired = 'true';

    const buttons = Array.from(
      document.querySelectorAll<HTMLButtonElement>('[data-filter]'),
    );
    const search = document.getElementById('project-search') as HTMLInputElement | null;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-project]'));
    const empty = document.getElementById('empty-state');

    let domain = 'all';
    let query = '';

    function apply() {
      let visible = 0;

      for (const card of cards) {
        const matchesDomain = domain === 'all' || card.dataset.domain === domain;
        const haystack = [
          card.dataset.title ?? '',
          card.dataset.summary ?? '',
          card.dataset.tech ?? '',
        ].join(' ');
        const matchesQuery = query === '' || haystack.includes(query);
        const show = matchesDomain && matchesQuery;

        card.hidden = !show;
        if (show) visible += 1;
      }

      if (empty) empty.hidden = visible > 0 || cards.length === 0;
    }

    for (const button of buttons) {
      button.addEventListener('click', () => {
        domain = button.dataset.filter ?? 'all';
        for (const other of buttons) {
          other.setAttribute('aria-pressed', String(other === button));
        }
        apply();
      });
    }

    search?.addEventListener('input', () => {
      query = search.value.trim().toLowerCase();
      apply();
    });
  }

  wireProjectFilters();
  document.addEventListener('astro:after-swap', wireProjectFilters);
</script>
